{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@data/*": ["./src/data/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@styles/*": ["./src/styles/*"],
      "@lib/*": ["./src/lib/*"],
      "@images/*": ["./src/images/*"],
      "@config": ["./src/config.ts"],
      "@svelte": ["./src/svelte/src/*"],
      "@data": ["./src/data/*"]
    }
  }
}
