---
import MikesHouseV2 from "@layouts/MikesHouseV2.astro";

import { products } from "@data/products";

export function getStaticPaths() {
  return products.map((data) => {
    const param = {
      params: {
        slug: data.slug.toLowerCase().replace(" ", "-"),
        photo: data.image,
      },
      props: {
        photo: data.image,
        name: data.name,
        price: data.price,
        description: data.description,
        available: data.available,
        product: data,
      },
    };
    return param;
  });
}

const { slug } = Astro.params;
const { product } = Astro.props;
---

<MikesHouseV2 title={slug} description="">
  <div
    class="font-roboto-flex uppercase font-bold overflow-clip relative leading-5 mt-0 sm:mt-2"
  >
    <img class="w-7/8 sm:w-2/3 mx-auto -z-10" src={product.image} />
    <div>
      <p>{product.name}</p>
      <p>${product.price}</p>
      <p class="text-xs">{product.description}</p>
      <div class="mt-2">
        {
          !product.available ? (
            <p class="2xl">sold out</p>
          ) : (
            <p>
              <a href={product.purchaseLink}>buy</a>
            </p>
          )
        }
      </div>
    </div>
  </div>
</MikesHouseV2>
