---
import MikesHouseV2 from "@layouts/MikesHouseV2.astro";

import { products } from "@data/products";

export function getStaticPaths() {
  return products.map((data) => {
    const param = {
      params: {
        slug: data.slug.toLowerCase().replace(" ", "-"),
        photo: data.image,
      },
      props: {
        photo: data.image,
        name: data.name,
        price: data.price,
        description: data.description,
        available: data.available,
        product: data,
      },
    };
    return param;
  });
}

const cartBtnId = "cartButton";

const { slug } = Astro.params;
const { product } = Astro.props;
---

<MikesHouseV2 title={slug} description="">
  <div
    class="font-roboto-flex uppercase font-bold overflow-clip relative leading-5 mt-0 sm:mt-2"
  >
    <img class="w-7/8 sm:w-2/3 mx-auto -z-10" src={product.image} />
    <div>
      <p>{product.name}</p>
      <p>${product.price}</p>
      <p class="text-xs">{product.description}</p>
      <div class="mt-2">
        {
          !product.available ? (
            <p class="2xl">sold out</p>
          ) : (
            <p>
              <button
                class="btn btn-neutral text-white"
                data-id={product.id}
                data-thumbnail-url={product.image}
                data-price={product.price}
                data-name={product.name}
                id={cartBtnId}
              >
                add to cart
              </button>
            </p>
          )
        }
      </div>
      <div class="w-7/8 sm:w-2/3 mx-auto">
        <!-- {
          product.variations?.map((obj) => (
            <button class="btn btn-outline">
              {obj.item_variation_data.name}
            </button>
          ))
        } -->
      </div>
    </div>
  </div>
</MikesHouseV2>

<script>
  import { addToCart } from "@lib/cart";

  const btnElem = document.getElementById("cartButton");

  btnElem?.addEventListener("click", addToCart);
</script>
