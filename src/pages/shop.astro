---
import MikesHouseV2 from "../layouts/MikesHouseV2.astro";

import { products } from "@data/products";
---

<MikesHouseV2
  title="Shop"
  description="Shop for official Mike's House merch, apparel, and other goods."
>
  <div
    class="flex flex-row justify-around items-center flex-wrap max-w-3/4 md:max-w-9/16 lg:max-w-13/16 mx-auto"
  >
    {
      products.map((product) => (
        <div class="shrink-0 mb-5 w-full lg:basis-1/3 lg:max-w-3/4 productCard relative">
          <div
            class={`absolute w-full h-full z-2 flex flex-col justify-end ${!product.available ? "" : "hidden"}`}
          >
            <p class="text-red-200 text-4xl font-roboto-flex pb-15">sold out</p>
          </div>
          <a href={`/products/${product.slug}`}>
            <img
              class={`w-full ${!product.available ? "grayscale-100" : ""}`}
              src={product.image}
              alt={product.name}
            />
          </a>
        </div>
      ))
    }
  </div>
</MikesHouseV2>

<script></script>
