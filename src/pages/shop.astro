---
import MikesHouseV2 from "../layouts/MikesHouseV2.astro";

import { products } from "@data/products";
---

<MikesHouseV2
  title="Shop"
  description="Shop for official Mike's House merch, apparel, and other goods."
>
  <div class="w-3/4 mx-auto">
    <div class="flex flex-row justify-around items-center flex-wrap">
      {
        products.map((product) => (
          <div class="shrink-0 w-full md:w-1/3 productCard relative">
            <div
              class={`absolute w-full h-[245px] md:h-[265px] z-2 flex flex-col justify-start ${!product.available ? "" : "hidden"}`}
            >
              <p class="text-red-200 text-4xl font-roboto-flex pt-15">
                sold out
              </p>
            </div>
            <a href={`/products/${product.slug}`}>
              <img
                class={`h-[245px] md:h-[265px] w-400 object-cover ${!product.available ? "grayscale-100" : ""}`}
                src={product.image}
                alt={product.name}
              />
              <p class="text-xl">
                {/* <a target="blank" href="https://square.link/u/SBtk0Zcy"> */}
                {/* <span>${product.price}</span> */}
                {/* </a> */}
              </p>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</MikesHouseV2>

<script></script>
