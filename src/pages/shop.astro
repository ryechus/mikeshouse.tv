---
import { Image } from "astro:assets";
import MikesHouseV2 from "../layouts/MikesHouseV2.astro";

import { products } from "@data/products";
import Copyright from "@components/Copyright.astro";
---

<MikesHouseV2
  title="Shop"
  description="Shop for official Mike's House merch, apparel, and other goods."
>
  <div
    class="flex flex-row justify-center items-center flex-wrap mx-auto mt-0 sm:mt-2 xl:mt-8 p-7 xl:p-0"
  >
    {
      products.map((product) => (
        <div class="shrink-0 mb-5 w-full md:basis-1/2 xl:basis-3/8 productCard relative">
          <div
            class={`absolute w-full h-full z-2 flex flex-col justify-end ${!product.available ? "" : "hidden"}`}
          />
          <a
            class={!product.available ? "no-underline" : ""}
            href={`/products/${product.slug}`}
          >
            <Image
              class={`w-7/8 mx-auto ${!product.available ? "grayscale-100" : ""}`}
              width={100}
              height={100}
              src={product.image}
              alt=""
            />
            {/* <img
              class={`w-full ${!product.available ? "grayscale-100" : ""}`}
              src={product.image}
              alt={product.name}
            /> */}
            <div class="font-roboto-flex uppercase font-bold text-md leading-5">
              <p>
                <span>{product.name}</span>
                <br />
                {product.available ? (
                  `$${product.price}`
                ) : (
                  <span class="text-red-400">sold out</span>
                )}
              </p>
            </div>
          </a>
        </div>
      ))
    }
  </div>
  <Copyright slot="footer" />
</MikesHouseV2>
