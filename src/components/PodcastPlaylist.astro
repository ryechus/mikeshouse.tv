---
import data from "@data/yt-playlist.json";
import dataVODS from "@data/yt-playlist-vods.json";
import moment from "moment";

const itemsShows = data.items;
const itemsVODS = dataVODS.items;
const unsortedItems = [...itemsShows, ...itemsVODS];

const nonPrivate = unsortedItems.filter(
  (item: any) => item.snippet.title.toLowerCase() !== "private video",
);

const youtubeUrl = (videoId: string) => {
  return `https://youtu.be/${videoId}`;
};

const readableDateTime = (dateTime: string) => {
  const m = moment(dateTime, moment.ISO_8601);
  return m.fromNow();
};

const showsCheckboxId = "selectShows";
const vodsCheckboxId = "selectVODS";
const searchBarId = "fliterSearchId";
const noSearchResultsId = "noSearchResults";

function compareFn(a: any, b: any) {
  const aPubAt = new Date(a.contentDetails.videoPublishedAt);
  const bPubAt = new Date(b.contentDetails.videoPublishedAt);
  return bPubAt.getTime() - aPubAt.getTime();
}

const items = nonPrivate.sort(compareFn);

const mainChannelId = "UCtogQThyg2l30nS_TMUNDpQ";

const isShow = (item: any) => {
  return item.snippet.channelId === mainChannelId;
};

const checkBoxClasses = "mr-1 checkbox checkbox-neutral checkbox-xs";
---

<div class="px-4.25 sm:px-10 shrink-0 min-w-full">
  <div
    class="mb-4 sm:mb-1 sm:pl-10 lg:pl-1 text-left flex flex-row justify-after items-center"
  >
    <input
      id={searchBarId}
      type="text"
      class="input max-w-1/2 input-ghost input-md font-roboto-flex font-semibold"
      placeholder="search"
    />
    <div class="ml-auto text-lg videoFilters pr-1">
      <input
        id={showsCheckboxId}
        class={checkBoxClasses}
        type="checkbox"
        checked="checked"
      /><span>shows</span>
      <input
        id={vodsCheckboxId}
        class={checkBoxClasses}
        type="checkbox"
        checked="checked"
      /><span>vods</span>
    </div>
  </div>
  <div class="font-roboto-flex font-semibold flex flex-row flex-wrap">
    <div id={noSearchResultsId} class="min-w-full hidden">
      <p class="pt-10">No videos found</p>
    </div>
    {
      items.map((item: any) => (
        <div
          data-title={item.snippet.title}
          class={`text-left sm:px-10 sm:max-w-7/8 lg:p-1.5 lg:basis-1/3 lg:max-w-3/4 mb-5 sm:mb-0 videoThumbnails ${isShow(item) ? "shows" : "vods"}`}
        >
          <a
            class="no-underline lowercase"
            href={youtubeUrl(item.contentDetails.videoId)}
          >
            <img
              class="thumbnail rounded-xs"
              src={item.snippet.thumbnails.maxres.url}
            />
            <p class="mt-2 line-clamp-1">{item.snippet.title}</p>
            <p class="text-xs">
              {readableDateTime(item.contentDetails.videoPublishedAt)}
            </p>
          </a>
        </div>
      ))
    }
  </div>
</div>

<style>
  @reference "tailwindcss";
  img.thumbnail:hover {
    filter: brightness(85%); /* 100% is normal, lower is darker */
  }
</style>

<script
  define:vars={{
    showsCheckboxId,
    vodsCheckboxId,
    searchBarId,
    noSearchResultsId,
  }}
>
  const showsCheckbox = document.getElementById(showsCheckboxId);
  const vodsCheckbox = document.getElementById(vodsCheckboxId);
  const searchBar = document.getElementById(searchBarId);

  const debounce = (func, delay) => {
    let timeout;
    return (...args) => {
      clearTimeout(timeout);
      timeout = setTimeout(() => func.apply(this, args), delay);
    };
  };

  const toggleShowsVisibility = (visible, thumbnailType) => {
    let thumbnails = undefined;
    if (thumbnailType === "vods") {
      thumbnails = document.querySelectorAll(".vods");
    } else if (thumbnailType === "shows") {
      thumbnails = document.querySelectorAll(".shows");
    } else {
      return;
    }

    thumbnails.forEach((card) => {
      if (!visible) {
        card.classList.add("hidden");
      } else {
        card.classList.remove("hidden");
      }
    });
  };

  const textSearch = debounce((e) => {
    const thumbnails = document.querySelectorAll(".videoThumbnails");
    const notFoundElement = document.getElementById(noSearchResultsId);

    const val = e.target.value;
    console.log("running search:", val);
    let found = false;
    if (val.trim() !== "") {
      thumbnails.forEach((card) => {
        if (!card.dataset.title.includes(e.target.value)) {
          notFoundElement.classList.add("hidden");
          card.classList.add("hidden");
        } else {
          card.classList.remove("hidden");
          found = true;
        }
      });

      if (!found) {
        notFoundElement.classList.remove("hidden");
      }
    } else {
      thumbnails.forEach((card) => {
        card.classList.remove("hidden");
      });
      notFoundElement.classList.add("hidden");
    }
    return;
  }, 250);

  const toggle = (e) => {
    if (e.target.id === showsCheckboxId) {
      toggleShowsVisibility(e.target.checked, "shows");
    }

    if (e.target.id === vodsCheckboxId) {
      toggleShowsVisibility(e.target.checked, "vods");
    }
  };

  showsCheckbox.addEventListener("change", toggle);
  vodsCheckbox.addEventListener("change", toggle);
  searchBar.addEventListener("keyup", textSearch);
</script>
